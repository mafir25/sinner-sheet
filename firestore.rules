rules_version = '2';
// Полные правила Firestore для сайта (база «default»).
// Как применить: Firebase Console → Firestore Database → база «default» → Rules →
// заменить ВЕСЬ текст содержимым этого файла → Publish.
// Всё, что здесь не описано, запрещено (в том числе коллекция sinners от удалённой системы «Тёмный мир»).
// Роли: Кодер (email ниже) → Гл-Админ → Админ. Подробности — README, раздел «Администрирование».
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email; }
    function isShortString(v, max) { return v is string && v.size() <= max; }

    // ================= Роли (site/auth.js, admin.html) =================
    // Кодер — владелец сайта, задан email-ом. Тот же список — CODER_EMAILS в site/auth.js; меняйте оба места.
    function isCoder() { return signedIn() && myEmail().lower() in ['nikkitamatveev2009@gmail.com']; }
    // roles/<uid> = { role: 'headadmin' | 'admin', perms: { canon: [группы], moderate, monitor, ban }, … }
    function roleData() {
      return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data
        : { 'role': '', 'perms': {} };
    }
    function isHead() { return isCoder() || roleData().role == 'headadmin'; }
    function isStaff() { return isCoder() || roleData().role in ['headadmin', 'admin']; }
    // Право Админа (Гл-Админ и Кодер имеют все права)
    function can(perm) {
      let r = roleData();
      return isCoder() || r.role == 'headadmin' || (r.role == 'admin' && r.perms.get(perm, false) == true);
    }
    function canCanon(group) {
      let r = roleData();
      return isCoder() || r.role == 'headadmin' || (r.role == 'admin' && group in r.perms.get('canon', []));
    }
    // Блокировка: bans/<uid>. Без until — навсегда. Кодера заблокировать нельзя.
    function banPath() { return /databases/$(database)/documents/bans/$(request.auth.uid); }
    function notBanned() {
      return signedIn() && (isCoder() || !exists(banPath())
        || (get(banPath()).data.get('until', null) != null && get(banPath()).data.until < request.time));
    }

    match /roles/{uid} {
      function validRole(d) {
        return d.keys().hasOnly(['role', 'perms', 'nick', 'grantedBy', 'grantedByNick', 'updatedAt'])
          && d.role in ['headadmin', 'admin']
          && d.perms is map
          && d.perms.keys().hasOnly(['canon', 'moderate', 'monitor', 'ban'])
          && d.perms.get('canon', []) is list
          && d.perms.get('canon', []).toSet().hasOnly(['characters', 'items', 'mechanics', 'world', 'articles', 'builder'])
          && d.perms.get('moderate', false) is bool
          && d.perms.get('monitor', false) is bool
          && d.perms.get('ban', false) is bool
          && isShortString(d.get('nick', ''), 40)
          && d.grantedBy == request.auth.uid
          && isShortString(d.get('grantedByNick', ''), 40)
          && d.updatedAt == request.time;
      }
      // Гл-Админ управляет только Админами (не собой, не другими Гл-Админами); Кодер — всеми.
      function headManages(d) { return isHead() && d.role == 'admin' && uid != request.auth.uid; }

      allow read: if signedIn() && (request.auth.uid == uid || isHead() || can('monitor'));
      allow create: if validRole(request.resource.data) && (isCoder() || headManages(request.resource.data));
      allow update: if validRole(request.resource.data)
        && (isCoder() || (headManages(resource.data) && headManages(request.resource.data)));
      allow delete: if isCoder() || headManages(resource.data);
    }

    // Старая схема админов (admins/<email>) больше не действует — права только через roles/.
    match /admins/{email} {
      allow read, write: if false;
    }

    // ================= Блокировки =================
    match /bans/{uid} {
      function validBan(d) {
        return d.keys().hasOnly(['nick', 'reason', 'until', 'by', 'byNick', 'at'])
          && isShortString(d.get('nick', ''), 40)
          && isShortString(d.get('reason', ''), 500)
          && (d.get('until', null) == null || d.until is timestamp)
          && d.by == request.auth.uid
          && isShortString(d.get('byNick', ''), 40)
          && d.at == request.time;
      }
      // Себя заблокировать нельзя; сотрудника с ролью может заблокировать только Кодер.
      function mayBan() {
        return can('ban') && uid != request.auth.uid
          && (isCoder() || !exists(/databases/$(database)/documents/roles/$(uid)));
      }
      allow read: if signedIn() && (request.auth.uid == uid || can('ban') || can('monitor'));
      allow create, update: if mayBan() && validBan(request.resource.data);
      // снять бан с сотрудника (его мог поставить только Кодер) — тоже только Кодер
      allow delete: if can('ban') && (isCoder() || !exists(/databases/$(database)/documents/roles/$(uid)));
    }

    // ================= Активность (мониторинг) =================
    match /presence/{uid} {
      function validPresence(d) {
        return d.keys().hasOnly(['nick', 'email', 'page', 'lastSeen', 'firstSeen'])
          && isShortString(d.get('nick', ''), 40)
          && d.email == myEmail()
          && isShortString(d.get('page', ''), 80)
          && d.lastSeen == request.time;
      }
      allow read: if can('monitor') || can('ban');
      allow create: if signedIn() && request.auth.uid == uid && validPresence(request.resource.data)
        && request.resource.data.firstSeen == request.time;
      allow update: if signedIn() && request.auth.uid == uid && validPresence(request.resource.data)
        && request.resource.data.get('firstSeen', null) == resource.data.get('firstSeen', null);
      allow delete: if isCoder();
    }

    // ================= Журнал действий =================
    // Записи добавляют сотрудники (вместе с самим действием, одной пачкой). Менять нельзя, чистить может Кодер.
    match /audit/{id} {
      allow read: if can('monitor');
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['at', 'uid', 'nick', 'action', 'target', 'details'])
        && request.resource.data.at == request.time
        && request.resource.data.uid == request.auth.uid
        && isShortString(request.resource.data.get('nick', ''), 40)
        && isShortString(request.resource.data.action, 60)
        && isShortString(request.resource.data.get('target', ''), 300)
        && isShortString(request.resource.data.get('details', ''), 60000);
      allow update: if false;
      allow delete: if isCoder();
    }

    // ================= Каноничные данные =================
    // canon/<Rus|Eng>__<группа>__<файл> — манифест; canon/<…>/chunks/<NNN> — куски текста файла.
    // Читают все (сайт грузит канон отсюда, при ошибке — из Assets/). Пишут Админы с правом на группу.
    // version растёт ровно на 1 — два одновременных сохранения не затрут друг друга.
    match /canon/{fid} {
      function validManifest(d) {
        return d.keys().hasOnly(['lang', 'group', 'name', 'version', 'chunks', 'size', 'updatedAt', 'updatedBy', 'updatedByNick', 'note'])
          && d.lang in ['Rus', 'Eng']
          && d.group in ['characters', 'items', 'mechanics', 'world', 'articles', 'builder']
          && d.name is string && d.name.matches('[A-Za-z0-9_.-]{1,80}')
          && fid == d.lang + '__' + d.group + '__' + d.name
          && d.version is int
          && d.chunks is int && d.chunks >= 1 && d.chunks <= 40
          && d.size is int
          && d.updatedAt == request.time
          && d.updatedBy == request.auth.uid
          && isShortString(d.get('updatedByNick', ''), 40)
          && isShortString(d.get('note', ''), 300);
      }
      allow read: if true;
      allow create: if validManifest(request.resource.data) && request.resource.data.version == 1
        && canCanon(request.resource.data.group) && notBanned();
      allow update: if validManifest(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.group == resource.data.group
        && canCanon(resource.data.group) && notBanned();
      allow delete: if canCanon(resource.data.group) && notBanned();

      match /chunks/{cid} {
        function manifestPath() { return /databases/$(database)/documents/canon/$(fid); }
        // Куски пишутся одной пачкой с манифестом: при сохранении смотрим новый манифест, при удалении файла — старый.
        function fileGroup() {
          return existsAfter(manifestPath()) ? getAfter(manifestPath()).data.group : get(manifestPath()).data.group;
        }
        allow read: if true;
        allow create, update: if canCanon(fileGroup()) && notBanned()
          && request.resource.data.keys().hasOnly(['data', 'v'])
          && request.resource.data.data is string
          && request.resource.data.v == getAfter(manifestPath()).data.version;
        allow delete: if canCanon(fileGroup()) && notBanned();
      }
    }

    // ---------------- Пользовательская база (navigation.html)
    // type: baseclass — основной класс; class — архетип (data.Class — ссылка на класс: id канона или «c:<id записи>»).
    match /custom_content/{id} {
      function validContent(d) {
        return d.keys().hasOnly(['type', 'data', 'isPrivate', 'updatedAt', 'creatorEmail', 'creator'])
          && d.type in ['status', 'baseclass', 'class', 'feat', 'gift', 'equip', 'bestiary', 'rule', 'lore']
          && d.data is map
          && d.isPrivate is bool
          && (!('creator' in d) || isShortString(d.creator, 80))
          && d.creatorEmail is string;
      }
      function isOwner() { return signedIn() && resource.data.creatorEmail == myEmail(); }

      // публичное видят все (даже без входа), приватное — автор и Админы с правом модерации.
      // Именно isPrivate == false, а не .get('isPrivate', false): с .get() запрос без фильтра проходил
      // и отдавал чужие приватные записи. Записи без флага видят автор и модераторы (Модерация → «Проставить флаг»).
      allow read: if resource.data.isPrivate == false || isOwner() || can('moderate');
      allow create: if signedIn() && notBanned()
        && request.resource.data.creatorEmail == myEmail()
        && validContent(request.resource.data);
      allow update: if ((isOwner() && notBanned()) || can('moderate'))
        && request.resource.data.creatorEmail == resource.data.creatorEmail
        && validContent(request.resource.data);
      allow delete: if isOwner() || can('moderate');
    }

    // ---------------- Реестр ников (site/auth.js)
    // nicknames/<nickId> = { uid, nick } — ник уникален; users/<uid> = { nick, nickId } — текущий ник аккаунта.
    // Пишутся вместе одной транзакцией. Держать можно только один ник: занять новый можно, лишь указав его
    // в своём users/<uid>, а сменить ник в users/<uid> — только удалив старый документ ника.
    match /nicknames/{nid} {
      function validNick(d) {
        return d.keys().hasOnly(['uid', 'nick']) && d.uid == request.auth.uid
          && isShortString(d.nick, 40) && d.nick.size() > 0;
      }
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && validNick(request.resource.data)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickId == nid;
      allow update: if signedIn() && notBanned() && resource.data.uid == request.auth.uid && validNick(request.resource.data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'nickId'])
        && isShortString(request.resource.data.nick, 40)
        && request.resource.data.nickId is string
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickId)).data.uid == uid
        && (resource == null
            || resource.data.nickId == request.resource.data.nickId
            || !existsAfter(/databases/$(database)/documents/nicknames/$(resource.data.nickId)));
      allow delete: if false;
    }

    // ---------------- Офисы (office.html, site/office.js)
    // Участники — по аккаунту (memberUids, их добавляют по нику). members — старый список email:
    // он ещё даёт доступ, пока участник не зайдёт в Офис (тогда он сам переносит себя в memberUids).
    // Меняет офис создатель; участник может только добавить/убрать самого себя (переход со старого списка и «покинуть офис»).
    match /offices/{oid} {
      function isCreatorOf(d) {
        return ('creatorUid' in d) ? d.creatorUid == request.auth.uid : d.get('creator', '') == myEmail();
      }
      function inLegacyList(d) {
        return myEmail() in d.get('members', []) || myEmail().lower() in d.get('members', []);
      }
      function isMemberOf(d) {
        return request.auth.uid in d.get('memberUids', []) || inLegacyList(d) || isCreatorOf(d);
      }
      function office() { return get(/databases/$(database)/documents/offices/$(oid)).data; }

      function creatorKept(n, o) {
        return n.get('creator', '') == o.get('creator', '')
          && n.creatorUid == o.get('creatorUid', request.auth.uid)
          && request.auth.uid in n.memberUids;
      }
      // участник меняет только свою запись: свой uid в memberUids, своё имя в memberNames, свой email в members
      function onlySelf(n, o) {
        return n.diff(o).affectedKeys().hasOnly(['memberUids', 'memberNames', 'members'])
          && n.get('memberUids', []).toSet().difference(o.get('memberUids', []).toSet()).hasOnly([request.auth.uid])
          && o.get('memberUids', []).toSet().difference(n.get('memberUids', []).toSet()).hasOnly([request.auth.uid])
          && n.get('memberNames', {}).diff(o.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid])
          && o.get('members', []).toSet().difference(n.get('members', []).toSet()).hasOnly([myEmail(), myEmail().lower()])
          && n.get('members', []).toSet().difference(o.get('members', []).toSet()).size() == 0;
      }

      // resource == null — офис удалён: слушатель получает «документа нет», а не ошибку доступа.
      // Гл-Админ видит все офисы и может удалить любой.
      allow read: if signedIn() && (resource == null || isMemberOf(resource.data) || isHead());
      allow create: if signedIn() && notBanned()
        && request.resource.data.creator == myEmail()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn() && notBanned() && (
        (isCreatorOf(resource.data) && request.resource.data.memberUids is list
          && creatorKept(request.resource.data, resource.data))
        || (!isCreatorOf(resource.data) && isMemberOf(resource.data) && onlySelf(request.resource.data, resource.data))
      );
      allow delete: if signedIn() && (isCreatorOf(resource.data) || isHead());

      // Досье агентов. Создатель офиса управляет всеми; участник может добавить своё досье
      // и обновлять досье, привязанные к нему (ownerUid), но не переназначать их.
      match /agents/{aid} {
        function validAgent(d) {
          return d.keys().hasOnly(['name', 'race', 'className', 'level', 'feats', 'description', 'presetJson',
                                   'ownerUid', 'ownerName', 'createdAt', 'updatedAt', 'order'])
            && isShortString(d.name, 120)
            && d.get('ownerUid', '') is string
            && d.get('presetJson', '') is string && d.get('presetJson', '').size() < 600000;
        }
        allow read: if signedIn() && (isHead() || isMemberOf(office()));
        allow create: if signedIn() && notBanned() && validAgent(request.resource.data) && (
          isCreatorOf(office())
          || (isMemberOf(office()) && request.resource.data.ownerUid == request.auth.uid));
        allow update: if signedIn() && notBanned() && validAgent(request.resource.data) && (
          isCreatorOf(office())
          || (isMemberOf(office()) && resource.data.ownerUid == request.auth.uid
              && request.resource.data.ownerUid == request.auth.uid));
        // офис мог быть уже удалён (Гл-Админ удаляет досье после офиса)
        allow delete: if signedIn() && (isHead() || isCreatorOf(office()));
      }
    }

    // ---------------- Ширмы (shirm.html)
    match /custom_screens/{sid} {
      function canRead(d) {
        return d.accessLevel == 'public'
          || d.creatorEmail == myEmail()
          || myEmail() in d.allowedUsers
          || myEmail() in d.adminUsers;
      }
      function canAdmin(d) { return d.creatorEmail == myEmail() || myEmail() in d.adminUsers; }
      function screen() { return get(/databases/$(database)/documents/custom_screens/$(sid)).data; }

      // Гл-Админ видит все Ширмы (вместе с «туманом войны») и может удалить любую.
      allow read: if signedIn() && (canRead(resource.data) || isHead());
      allow create: if signedIn() && notBanned() && request.resource.data.creatorEmail == myEmail();
      // админы могут переименовывать и переводить формат; доступы и автора меняет только создатель
      allow update: if signedIn() && notBanned() && canAdmin(resource.data)
        && request.resource.data.creatorEmail == resource.data.creatorEmail
        && (resource.data.creatorEmail == myEmail()
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['allowedUsers', 'adminUsers', 'accessLevel']));
      allow delete: if signedIn() && (resource.data.creatorEmail == myEmail() || isHead());

      // видимые объекты доски
      match /items/{iid} {
        allow read: if signedIn() && (isHead() || canRead(screen()));
        allow write: if signedIn() && notBanned() && canAdmin(screen());
        allow delete: if signedIn() && isHead();
      }
      // скрытые объекты («туман войны») — только админы ширмы (и Гл-Админ сайта)
      match /secret/{iid} {
        allow read: if signedIn() && (isHead() || canAdmin(screen()));
        allow write: if signedIn() && notBanned() && canAdmin(screen());
        allow delete: if signedIn() && isHead();
      }
    }

    // ---------------- Личные заметки мастера
    match /gm_notes/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
